# Copy this file to .env for local development. Never commit the resulting .env file.

# Core runtime
NODE_ENV=development
PORT=3000

# Required for the active planner data layer. Use a dedicated least-privilege account.
DATABASE_URL=mysql://APPLICATION_USER:APPLICATION_PASSWORD@127.0.0.1:3306/wedding_planner

# Optional DDL-capable database account for isolated migration verification only.
MIGRATION_DATABASE_URL=mysql://MIGRATION_USER:MIGRATION_PASSWORD@127.0.0.1:3306/wedding_planner

# Optional legacy/template integrations. The active no-login planner does not require these.
JWT_SECRET=
VITE_APP_ID=
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
OWNER_OPEN_ID=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
